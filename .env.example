# ==============================================================================
# ResearchOS — Configuration Template
# All settings default to zero-cost, offline-safe values.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (JSON list or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# LLM Provider Configuration
# Supported options: mock, ollama, gemini
# Default 'mock' requires NO API keys and operates 100% offline.
LLM_PROVIDER=mock
LOCAL_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Free-tier external providers (only if configured, never mandatory)
GEMINI_API_KEY=

# Data & Persistence Directories
DATA_DIR=./data
CACHE_DIR=./data/cache
EXPERIMENTS_DIR=./data/experiments
